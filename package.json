{
  "name": "izbica24-portal",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "lint": "node scripts/ci-lint.mjs",
    "test": "vitest run --coverage && playwright test",
    "test:ci": "node scripts/ci-test.mjs",
    "test:unit": "vitest run --coverage",
    "test:e2e": "playwright test",
    "deploy:staging": "bash scripts/deploy.sh staging",
    "deploy:prod": "bash scripts/deploy.sh prod",
    "migrate": "bash scripts/migrate.sh",
    "seed": "bash scripts/seed.sh",
    "rollback": "bash scripts/rollback.sh",
    "health-check": "bash scripts/health-check.sh",
    "dev:sandbox": "wrangler pages dev dist --d1=izbica24-production --local --ip 0.0.0.0 --port 3000",
    "db:migrate:local": "wrangler d1 migrations apply izbica24-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply izbica24-production --remote",
    "db:seed": "wrangler d1 execute izbica24-production --local --file=./seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local",
    "db:console:local": "wrangler d1 execute izbica24-production --local --command",
    "db:console:prod": "wrangler d1 execute izbica24-production --remote --command",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "db:verify": "node scripts/db-verify.mjs",
    "check:hotlinks": "node scripts/sprawdz-hotlinki.mjs",
    "i11:fix-images": "node scripts/i11-usun-obrazy-zewnetrzne.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.12.23",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.25.2",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.7",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.7",
    "wrangler": "^4.114.0"
  }
}
